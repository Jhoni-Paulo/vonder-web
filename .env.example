# Base da API do CMS (inclui o prefixo /api)
VITE_API_BASE_URL=http://10.1.12.100:8080/api

# JWT usado enquanto as rotas de conteudo do site publico ainda exigirem Bearer.
# Ver secao 0.5 do docs/INTEGRACAO-BACKEND.md.
VITE_API_TOKEN=

# Chave das rotas publicas que usam x-api-key (/home, /mega-menu).
# Nao e segredo: vai no bundle do browser e qualquer visitante consegue ler.
VITE_API_KEY=NADOLNY

# Host das imagens (NGINX). Se vazio, usa a origem da VITE_API_BASE_URL.
VITE_ASSETS_BASE_URL=
